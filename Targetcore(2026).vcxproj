  <!-- ===================================================================== -->
  <!-- DebugLib / ReleaseLib: static-library variants of the same sources.    -->
  <!--                                                                       -->
  <!-- Differences from the DLL configurations, all deliberate:               -->
  <!--   * Targetcore_STATIC replaces Targetcore_EXPORTS, so Targetcore_EXT   -->
  <!--     (Targetcore.h) and P2PC_API (Targetcore_c.h) expand to nothing.    -->
  <!--   * Msgcore_STATIC is ALSO defined, and is not optional. These TUs     -->
  <!--     include Msgcore's headers, so without it Msgcore_EXT expands to    -->
  <!--     dllimport and the archive records __imp_ references to Msgcore's   -->
  <!--     import thunks instead of plain calls. Most of those still resolve  -->
  <!--     against the static Msgcore, but only with a wall of LNK4217, and   -->
  <!--     the inline members of dllimport-decorated classes do not resolve   -->
  <!--     at all: P2Pevent::SetFParam(LPCTNAM, const P3PmsgItem&amp;) is defined  -->
  <!--     inline in Msgexception.h, so a dllimport view emits a call to an   -->
  <!--     export that the static Msgcore never produced, and the consumer    -->
  <!--     link dies on LNK2001. Consumers of these archives must define BOTH -->
  <!--     macros for exactly the same reason.                                -->
  <!--   * _AFXEXT is NOT defined. It declares an MFC *extension DLL*; an     -->
  <!--     archive is not a module and has no CDynLinkLibrary resource chain. -->
  <!--     Leaving it set would decorate MFC's own AFX_EXT_CLASS dllexport in  -->
  <!--     a target that exports nothing.                                     -->
  <!--   * No <Link>, no CustomBuildStep. There is no image to link and       -->
  <!--     nothing to deploy; the consumer's link does both.                  -->
  <!--   * No Msgcore.lib / ws2_32 / MsWsock / comsuppwd / Propsys here.      -->
  <!--     A static library records no dependencies, so THE CONSUMER must     -->
  <!--     link those itself, and must use the matching STATIC Msgcore        -->
  <!--     (Msgcore DebugLib/ReleaseLib). Mixing static Targetcore with the   -->
  <!--     Msgcore DLL puts two copies of the Msgcore heap in one process.    -->
  <!--                                                                       -->
  <!-- The archive lands in $(OutDir) (which is also $(TargetPath), so        -->
  <!-- MSBuild's up-to-date check stays honest) and a PostBuildEvent stages a -->
  <!-- copy into $(WDMSCS_LIB) = lib\<Platform>\<Configuration>, the same     -->
  <!-- place the DLL configurations put their import library. The Lib tool    -->
  <!-- has no <ImportLibrary> equivalent, which is why the copy is explicit;  -->
  <!-- it runs unconditionally on every build, so the staged copy can never   -->
  <!-- lag the one in out\.                                                   -->
  <!-- ===================================================================== -->
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='DebugLib|Win32'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <PreprocessorDefinitions>WIN32;_WINDOWS;_DEBUG;Msgcore_STATIC;Targetcore_STATIC;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <MinimalRebuild>false</MinimalRebuild>
      <BasicRuntimeChecks>EnableFastChecks</BasicRuntimeChecks>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
      <RuntimeTypeInfo>true</RuntimeTypeInfo>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <WarningLevel>Level4</WarningLevel>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <BrowseInformation>true</BrowseInformation>
      <AdditionalIncludeDirectories>..\Msgcore</AdditionalIncludeDirectories>
      <AdditionalOptions>/Zc:throwingNew %(AdditionalOptions)</AdditionalOptions>
      <LanguageStandard>stdcpplatest</LanguageStandard>
      <LanguageStandard_C>stdc17</LanguageStandard_C>
    </ClCompile>
    <Lib>
      <OutputFile>$(OutDir)$(TargetName).lib</OutputFile>
    </Lib>
    <PostBuildEvent>
      <Command>if not exist "$(WDMSCS_LIB)" mkdir "$(WDMSCS_LIB)"
copy /Y "$(OutDir)$(TargetName).lib" "$(WDMSCS_LIB)\$(TargetName).lib"</Command>
      <Message>Staging static $(TargetName).lib to $(WDMSCS_LIB)</Message>
    </PostBuildEvent>
    <ProjectReference>
      <UseLibraryDependencyInputs>false</UseLibraryDependencyInputs>
    </ProjectReference>
    <Bscmake>
      <PreserveSbr>true</PreserveSbr>
    </Bscmake>
  </ItemDefinitionGroup>
