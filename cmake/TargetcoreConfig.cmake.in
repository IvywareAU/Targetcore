#
# TargetcoreConfig.cmake - what find_package(Targetcore) loads.
#
# It declares ONE imported target, Targetcore::targetcore, and pulls in its one
# real dependency first. The find_dependency(Msgcore) is not a formality: the
# installed targetcore cannot LOAD without libmsgcore beside it, so a config
# that resolved without it would hand a consumer a link line that builds and an
# executable that dies at startup -- which is the failure this package exists to
# make impossible.
#
# Msgcore is exported by its own repository under its own namespace, and is
# found here through CMAKE_PREFIX_PATH: a consumer that points at the install
# prefix finds both, because `cmake --install` stages both into it. If Msgcore
# lives somewhere else, point CMAKE_PREFIX_PATH at both prefixes.
#
# NOT declared, deliberately: p2pplatform (a build-time include-path shim that
# ships nothing), and on Linux OpenSSL and liburing (implementation
# dependencies of a shared library, already recorded in its DT_NEEDED). None of
# the three is needed to build against the installed library, and demanding
# their development packages would make the config lie about what it needs.
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Msgcore)

include("${CMAKE_CURRENT_LIST_DIR}/TargetcoreTargets.cmake")

check_required_components(Targetcore)
